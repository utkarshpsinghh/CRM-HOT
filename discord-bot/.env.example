# ==============================================================================
# HOT Alliance Discord Bot Configuration
# ==============================================================================

# 1. Discord Bot Credentials (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here
DISCORD_GUILD_ID=your_hot_discord_server_id_here

# 2. CRM API Connection (crm.1391.online)
CRM_API_BASE_URL=https://crm.1391.online/api/v1
CRM_API_KEY=hot_crm_your_generated_api_key_from_crm_settings

# 3. Security & Roles (Optional)
# Name of the role in your Discord server that has officer permissions
OFFICER_ROLE_NAME=R4 Officer
